# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# MONGODB_URI: MongoDB Atlas connection string for persisting users and saved study materials.
MONGODB_URI="MY_MONGODB_URI"

# SESSION_SECRET: Secret key used to sign session cookies and tokens.
SESSION_SECRET="MY_SESSION_SECRET"

# YOUTUBE_API_KEY: YouTube Data API v3 key for searching educational videos.
YOUTUBE_API_KEY="MY_YOUTUBE_API_KEY"

# GROQ_API_KEY: Optional secondary free-tier AI fallback (Llama 3.3 via Groq) if Gemini is rate-limited.
GROQ_API_KEY=""
